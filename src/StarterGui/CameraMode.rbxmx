			<Item class="LocalScript" referent="RBX6698B6237B87484791D813C10FA2A673">
				<Properties>
					<ProtectedString name="Source">local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer

local gui = script.Parent
local toggleButton = gui:WaitForChild("ToggleButton")
local pressScale = toggleButton:WaitForChild("PressScale")
local lip = toggleButton:WaitForChild("Lip")
local face = toggleButton:WaitForChild("Face")
local labelTop = face:WaitForChild("LabelTop") -- BUTTON, or EXIT while in camera mode
local sweep = face:WaitForChild("Sweep")
local buttonImage = face:WaitForChild("IconBadge"):WaitForChild("ButtonImage")
local imageScale = buttonImage:WaitForChild("IdleScale")

local buttonModel = workspace
	:WaitForChild("Islands")
	:WaitForChild("Island1")
	:WaitForChild("RedButton")
	:WaitForChild("Button")

-- camera view settings
local CAMERA_OFFSET = Vector3.new(0, 7, 24) -- where the camera sits, relative to the button
local LOOK_OFFSET = Vector3.new(0, 1, 0)    -- point it looks at, relative to the button
local ENTER_TIME = 0.8
local EXIT_TIME = 0.6

-- button look
local FACE_NORMAL = Color3.fromRGB(255, 72, 84)
local LIP_NORMAL = Color3.fromRGB(150, 20, 38)
local FACE_ACTIVE = Color3.fromRGB(72, 78, 120)
local LIP_ACTIVE = Color3.fromRGB(30, 34, 70)

local FACE_UP = UDim2.fromScale(0.5, 0.43)
local FACE_DOWN = UDim2.fromScale(0.5, 0.5) -- pressed flat onto the lip

local SWEEP_START = UDim2.fromScale(-0.3, 0.5)
local SWEEP_END = UDim2.fromScale(1.3, 0.5)
local SWEEP_EVERY = 4 -- seconds between shine sweeps

local HOVER_SCALE = 1.06
local PRESS_SCALE = 0.96
local HOVER_TILT = 2 -- degrees

-- idle animation of the button icon
local IMAGE_BREATHE_SCALE = 1.1  -- how big it swells
local IMAGE_BREATHE_TIME = 0.9   -- seconds per swell
local IMAGE_SWAY_DEGREES = 5     -- how far it tilts each way
local IMAGE_SWAY_TIME = 1.6      -- seconds per tilt

local inCameraMode = false
local hovering = false
local cameraTween = nil

local function tween(object, time, properties, style, direction)
	TweenService:Create(
		object,
		TweenInfo.new(
			time,
			style or Enum.EasingStyle.Quad,
			direction or Enum.EasingDirection.Out
		),
		properties
	):Play()
end

-- camera -----------------------------------------------------------

local function getCamera()
	return workspace.CurrentCamera
end

local function getViewCFrame()
	local focus = buttonModel:GetPivot().Position + LOOK_OFFSET

	return CFrame.lookAt(focus + CAMERA_OFFSET, focus)
end

-- a spot behind the player to glide back to when leaving
local function getReturnCFrame()
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")

	if not root then
		return nil
	end

	local position = (root.CFrame * CFrame.new(0, 3, 12)).Position

	return CFrame.lookAt(
		position,
		root.Position + Vector3.new(0, 2, 0)
	)
end

local function playCameraTween(camera, cframe, time, onDone)
	if cameraTween then
		cameraTween:Cancel()
	end

	cameraTween = TweenService:Create(
		camera,
		TweenInfo.new(
			time,
			Enum.EasingStyle.Quint,
			Enum.EasingDirection.InOut
		),
		{ CFrame = cframe }
	)

	local thisTween = cameraTween

	thisTween.Completed:Connect(function(state)
		if state == Enum.PlaybackState.Completed and onDone then
			onDone()
		end
	end)

	thisTween:Play()
end

-- button visuals ---------------------------------------------------

local function playSweep()
	sweep.Position = SWEEP_START

	tween(
		sweep,
		0.7,
		{ Position = SWEEP_END },
		Enum.EasingStyle.Quad,
		Enum.EasingDirection.InOut
	)
end

-- pop + color change when the mode switches
local function setButtonLook(active)
	labelTop.Text = active and "EXIT" or "BUTTON"

	tween(face, 0.25, {
		BackgroundColor3 = active and FACE_ACTIVE or FACE_NORMAL,
	})

	tween(lip, 0.25, {
		BackgroundColor3 = active and LIP_ACTIVE or LIP_NORMAL,
	})

	pressScale.Scale = 1.15

	tween(
		pressScale,
		0.35,
		{ Scale = hovering and HOVER_SCALE or 1 },
		Enum.EasingStyle.Back,
		Enum.EasingDirection.Out
	)

	playSweep()
end

-- camera modes -----------------------------------------------------

local function enterCameraMode()
	local camera = getCamera()

	inCameraMode = true
	setButtonLook(true)

	-- Scriptable keeps the camera where it is, then we glide to the view
	camera.CameraType = Enum.CameraType.Scriptable

	playCameraTween(camera, getViewCFrame(), ENTER_TIME)
end

local function exitCameraMode()
	local camera = getCamera()

	inCameraMode = false
	setButtonLook(false)

	local function giveBackControl()
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")

		camera.CameraType = Enum.CameraType.Custom

		if humanoid then
			camera.CameraSubject = humanoid
		end
	end

	local returnCFrame = getReturnCFrame()

	if returnCFrame then
		playCameraTween(camera, returnCFrame, EXIT_TIME, function()
			if not inCameraMode then
				giveBackControl()
			end
		end)
	else
		giveBackControl()
	end
end

toggleButton.Activated:Connect(function()
	if inCameraMode then
		exitCameraMode()
	else
		enterCameraMode()
	end
end)

-- hover / press feel -----------------------------------------------

toggleButton.MouseEnter:Connect(function()
	hovering = true

	tween(
		pressScale,
		0.18,
		{ Scale = HOVER_SCALE },
		Enum.EasingStyle.Back,
		Enum.EasingDirection.Out
	)

	tween(toggleButton, 0.18, { Rotation = -HOVER_TILT })
	playSweep()
end)

toggleButton.MouseLeave:Connect(function()
	hovering = false

	tween(pressScale, 0.18, { Scale = 1 })
	tween(toggleButton, 0.18, { Rotation = 0 })
	tween(face, 0.1, { Position = FACE_UP })
end)

toggleButton.MouseButton1Down:Connect(function()
	tween(face, 0.06, { Position = FACE_DOWN })
	tween(pressScale, 0.06, { Scale = PRESS_SCALE })
end)

toggleButton.MouseButton1Up:Connect(function()
	tween(
		face,
		0.14,
		{ Position = FACE_UP },
		Enum.EasingStyle.Back,
		Enum.EasingDirection.Out
	)

	tween(
		pressScale,
		0.14,
		{ Scale = hovering and HOVER_SCALE or 1 },
		Enum.EasingStyle.Back,
		Enum.EasingDirection.Out
	)
end)

-- a shine sweeps across every few seconds
task.spawn(function()
	while true do
		task.wait(SWEEP_EVERY)

		if not hovering then
			playSweep()
		end
	end
end)

-- idle: the button icon gently breathes and sways forever
-- (different timings so the two never line up)
buttonImage.Rotation = -IMAGE_SWAY_DEGREES

TweenService:Create(
	imageScale,
	TweenInfo.new(
		IMAGE_BREATHE_TIME,
		Enum.EasingStyle.Sine,
		Enum.EasingDirection.InOut,
		-1,
		true
	),
	{ Scale = IMAGE_BREATHE_SCALE }
):Play()

TweenService:Create(
	buttonImage,
	TweenInfo.new(
		IMAGE_SWAY_TIME,
		Enum.EasingStyle.Sine,
		Enum.EasingDirection.InOut,
		-1,
		true
	),
	{ Rotation = IMAGE_SWAY_DEGREES }
):Play()

setButtonLook(false)
