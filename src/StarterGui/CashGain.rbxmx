			<Item class="LocalScript" referent="RBX4A3D382C1CAE4F1FA75E2E592B02A4CA">
				<Properties>
					<ProtectedString name="Source">local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer

local gui = script.Parent
local template = gui:WaitForChild("GainTemplate")

-- settings
local LIFETIME = 1.4  -- seconds on screen
local RISE = 34       -- pixels it drifts up
local GAP = 8         -- pixels between the popup and the Cash row
local MIN_GAIN = 0.01 -- ignore smaller gains

local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }

-- 5 -&gt; "5", 12.5 -&gt; "12.5", 12345 -&gt; "12.3K"
local function formatNumber(value)
	if value &gt;= 1000 then
		local index = 0

		while value &gt;= 1000 and index &lt; #SUFFIXES - 1 do
			value /= 1000
			index += 1
		end

		local text = string.format("%.1f", math.floor(value * 10) / 10)
		text = text:gsub("%.0$", "")

		return text .. SUFFIXES[index + 1]
	end

	local text = string.format("%.2f", value)
	text = text:gsub("0+$", "")
	text = text:gsub("%.$", "")

	return text
end

local function findCashRow()
	local currencies = player.PlayerGui:FindFirstChild("Currencies")
	local main = currencies and currencies:FindFirstChild("MainCurrenciesFrame")
	local list = main and main:FindFirstChild("CurrenciesFrame")

	return list and list:FindFirstChild("Money")
end

local function showGain(gain)
	local camera = workspace.CurrentCamera
	local row = findCashRow()

	local x = camera.ViewportSize.X - 20
	local y = camera.ViewportSize.Y / 2

	if row then
		-- just to the left of the Cash row (kept on screen if the panel is closed)
		x = math.min(row.AbsolutePosition.X - GAP, camera.ViewportSize.X - 20)
		y = row.AbsolutePosition.Y + row.AbsoluteSize.Y / 2
	end

	local popup = template:Clone()
	popup.Name = "Gain"
	popup.Position = UDim2.fromOffset(x, y)
	popup.Visible = true

	local amountLabel = popup:WaitForChild("Amount")
	local icon = popup:WaitForChild("Icon")
	local scale = popup:WaitForChild("PopScale")

	-- in case they were hidden while editing the template
	amountLabel.Visible = true
	icon.Visible = true

	amountLabel.Text = "+" .. formatNumber(gain)
	scale.Scale = 0

	popup.Parent = gui

	-- pop in
	TweenService:Create(
		scale,
		TweenInfo.new(
			0.25,
			Enum.EasingStyle.Back,
			Enum.EasingDirection.Out
		),
		{ Scale = 1 }
	):Play()

	-- drift up
	TweenService:Create(
		popup,
		TweenInfo.new(
			LIFETIME,
			Enum.EasingStyle.Quad,
			Enum.EasingDirection.Out
		),
		{ Position = UDim2.fromOffset(x, y - RISE) }
	):Play()

	-- fade out during the second half
	local fadeInfo = TweenInfo.new(
		LIFETIME * 0.5,
		Enum.EasingStyle.Quad,
		Enum.EasingDirection.In,
		0,
		false,
		LIFETIME * 0.5
	)

	TweenService:Create(amountLabel, fadeInfo, { TextTransparency = 1 }):Play()
	TweenService:Create(icon, fadeInfo, { ImageTransparency = 1 }):Play()

	local stroke = amountLabel:FindFirstChildOfClass("UIStroke")

	if stroke then
		TweenService:Create(stroke, fadeInfo, { Transparency = 1 }):Play()
	end

	Debris:AddItem(popup, LIFETIME + 0.1)
end

-- don't pop a giant "+" for the saved Cash that loads when you join
local ready = player:GetAttribute("DataLoaded") == true
local lastCash = player:GetAttribute("Cash") or 0

if not ready then
	local connection

	connection = player:GetAttributeChangedSignal("DataLoaded"):Connect(function()
		if player:GetAttribute("DataLoaded") == true then
			connection:Disconnect()

			task.delay(1.5, function()
				lastCash = player:GetAttribute("Cash") or 0
				ready = true
			end)
		end
	end)
end

player:GetAttributeChangedSignal("Cash"):Connect(function()
	local cash = player:GetAttribute("Cash") or 0
	local gain = cash - lastCash

	lastCash = cash

	if ready and gain &gt;= MIN_GAIN then
		showGain(gain)
	end
end)
