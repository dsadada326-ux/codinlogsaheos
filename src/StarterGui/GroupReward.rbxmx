					<Item class="LocalScript" referent="RBXF53C6032059D4DCB8CA4BA6164021A53">
						<Properties>
							<ProtectedString name="Source">local groupservice = game:GetService("GroupService")

local player = game.Players.LocalPlayer

local groupid = 108910656
local button = script.Parent

local function check()
	local groups = groupservice:GetGroupsAsync(player.UserId)
	for i, group in pairs(groups) do
		if group.Id == groupid then
			return true
		end
	end
	return false
end

button.MouseButton1Click:Connect(function()
	if check() then
		groupservice:PromptJoinAsync(groupid)
	end
end)</ProtectedString>
