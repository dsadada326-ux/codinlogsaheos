			<Item class="LocalScript" referent="RBXC6324DA2B2BE476BAAD4F2FE878D52C5">
				<Properties>
					<ProtectedString name="Source">-- Keeps this SurfaceGui on its Laboratory board (Workspace.Labratory.LabBoards.LabLevelBoard.Board).
-- It lives in PlayerGui instead of on the part so players can scroll it and click the button.
local gui = script.Parent

local function find()
	local lab = workspace:FindFirstChild("Labratory")
	local boards = lab and lab:FindFirstChild("LabBoards")
	local model = boards and boards:FindFirstChild("LabLevelBoard")
	return model and model:FindFirstChild("Board")
end

while true do
	if not gui.Adornee or not gui.Adornee.Parent then
		gui.Adornee = find()
	end
	task.wait(1)
end
</ProtectedString>
