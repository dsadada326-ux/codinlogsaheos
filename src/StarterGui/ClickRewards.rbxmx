			<Item class="LocalScript" referent="RBXC93AD3E06B8A4D509C92A3F41FE08C28">
				<Properties>
					<ProtectedString name="Source">local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("ComboConfig"))
local clickReward = ReplicatedStorage
	:WaitForChild("Remotes")
	:WaitForChild("ClickReward")

local gui = script.Parent
local template = gui:WaitForChild("PopupTemplate")

-- the red button model: the red top and the white base ring
local buttonModel = workspace
	:WaitForChild("Islands")
	:WaitForChild("Island1")
	:WaitForChild("RedButton")
	:WaitForChild("Button")

local buttonPart = buttonModel:WaitForChild("Button")
local basePart = buttonModel:WaitForChild("Base")

-- settings
local HEIGHT_ABOVE_BUTTON = 1  -- studs above the top of the red button
local START_OFFSET = 10        -- extra pixels above that point where popups start
local FLOAT_DISTANCE = 45      -- pixels the popup rises
local LIFETIME = 0.85          -- seconds on screen
local SPREAD = 22              -- random sideways offset, so fast clicks don't stack
local MIN_SIZE = 0.85          -- popup size at 1.00x
local MAX_SIZE = 1.2           -- popup size at the max multiplier
local NORMAL_COLOR = Color3.fromRGB(255, 255, 255)
local MAX_COLOR = Color3.fromRGB(255, 214, 64)
local CRIT_COLOR = Color3.fromRGB(255, 110, 50) -- critical clicks
local CRIT_SIZE = 1.35                          -- and they are bigger
local AUTO_COLOR = Color3.fromRGB(130, 210, 255) -- income from Auto Clickers
local AUTO_SIZE = 0.8                            -- smaller, so it doesn't crowd your own clicks
local AUTO_SHIFT = 70                            -- pixels to the right of your own popups
local CRIT_LIFT = 26                             -- pixels the CRIT! label sits above the amount (scaled with size)
local CRIT_LABEL_SIZE = 1.1                      -- CRIT! is a touch bigger than the number

local active = {} -- popups currently floating

-- The red top squashes and bounces on every click, which would make the popups
-- jump around. So they are pinned to the white base (it never squashes) at a
-- fixed height above where the top of the button rests.
local anchorHeight = buttonPart.Position.Y
	+ buttonPart.Size.Y / 2
	+ HEIGHT_ABOVE_BUTTON
	- basePart.Position.Y

-- the point in the world just above the red button
local function getAnchorPoint()
	return basePart.Position + Vector3.new(0, anchorHeight, 0)
end

-- 1.5 -&gt; "+1.5", 1 -&gt; "+1", 1.37 -&gt; "+1.37"
local NumberFormat = require(ReplicatedStorage:WaitForChild("NumberFormat"))

local function formatAmount(amount)
	return "+" .. NumberFormat.amount(amount)
end

-- one floating piece of text: the amount, or the CRIT! label that sits above it
local function spawnPopup(text, color, size, spread, lift, showIcon, stamp)
	local popup = template:Clone()
	popup.Name = "Popup"
	popup.Visible = true

	local amountLabel = popup:WaitForChild("Amount")
	local icon = popup:WaitForChild("Icon")
	local scale = popup:WaitForChild("PopScale")

	-- in case they were hidden while editing the template in Studio
	amountLabel.Visible = true
	icon.Visible = showIcon

	amountLabel.Text = text
	amountLabel.TextColor3 = color
	scale.Scale = 0

	popup.Parent = gui

	table.insert(active, {
		popup = popup,
		start = os.clock(),
		spread = spread,
		lift = lift, -- pixels above the amount line
	})

	-- pop in
	TweenService:Create(
		scale,
		TweenInfo.new(
			0.18,
			Enum.EasingStyle.Back,
			Enum.EasingDirection.Out
		),
		{ Scale = size }
	):Play()

	-- the CRIT! label snaps upright like a stamp
	if stamp then
		popup.Rotation = -12

		TweenService:Create(
			popup,
			TweenInfo.new(
				0.3,
				Enum.EasingStyle.Back,
				Enum.EasingDirection.Out
			),
			{ Rotation = 0 }
		):Play()
	end

	-- fade out during the second half
	local fadeInfo = TweenInfo.new(
		LIFETIME * 0.5,
		Enum.EasingStyle.Quad,
		Enum.EasingDirection.In,
		0,
		false,
		LIFETIME * 0.5
	)

	TweenService:Create(amountLabel, fadeInfo, { TextTransparency = 1 }):Play()
	TweenService:Create(icon, fadeInfo, { ImageTransparency = 1 }):Play()

	local stroke = amountLabel:FindFirstChildOfClass("UIStroke")

	if stroke then
		TweenService:Create(stroke, fadeInfo, { Transparency = 1 }):Play()
	end
end

local Players = game:GetService("Players")
local player = Players.LocalPlayer
local island2Box = workspace:WaitForChild("IslandHitboxes"):WaitForChild("Island2")

-- these popups are for the red button on Island 1; skip them on Island 2 so nothing
-- clumps up on screen while you're over there
local function onIsland2()
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")

	if not root then
		return false
	end

	local p = island2Box.CFrame:PointToObjectSpace(root.Position)

	return math.abs(p.X) &lt;= island2Box.Size.X / 2 and math.abs(p.Z) &lt;= island2Box.Size.Z / 2
end

local function showPopup(amount, multiplier, crit, auto)
	if onIsland2() then
		return
	end

	local camera = workspace.CurrentCamera

	-- only show it if the button is actually on screen
	local _, onScreen = camera:WorldToViewportPoint(getAnchorPoint())

	if not onScreen then
		return
	end

	local progress = math.clamp(
		(multiplier - 1) / (Config.MaxMultiplier - 1),
		0,
		1
	)

	local spread = math.random(-SPREAD, SPREAD) + (auto and AUTO_SHIFT or 0)

	local size = (MIN_SIZE + (MAX_SIZE - MIN_SIZE) * progress)
		* (crit and CRIT_SIZE or 1)
		* (auto and AUTO_SIZE or 1)

	local color = (crit and CRIT_COLOR)
		or (auto and AUTO_COLOR)
		or NORMAL_COLOR:Lerp(MAX_COLOR, progress)

	-- the amount, with the button icon
	spawnPopup(formatAmount(amount), color, size, spread, 0, true, false)

	-- a critical click also gets "CRIT!" on its own line right above the amount
	if crit then
		local lift = math.floor(CRIT_LIFT * size + 0.5)

		spawnPopup("CRIT!", CRIT_COLOR, size * CRIT_LABEL_SIZE, spread, lift, false, true)
	end
end

-- popups stay attached to the button on screen, even while the camera moves
RunService.RenderStepped:Connect(function()
	if #active == 0 then
		return
	end

	local camera = workspace.CurrentCamera
	local screenPoint = camera:WorldToViewportPoint(getAnchorPoint())
	local now = os.clock()

	for index = #active, 1, -1 do
		local item = active[index]
		local t = (now - item.start) / LIFETIME

		if t &gt;= 1 or not item.popup.Parent then
			item.popup:Destroy()
			table.remove(active, index)
		else
			local eased = 1 - (1 - t) ^ 2 -- fast at first, slows down

			item.popup.Position = UDim2.fromOffset(
				screenPoint.X + item.spread,
				screenPoint.Y - START_OFFSET - FLOAT_DISTANCE * eased - (item.lift or 0)
			)
		end
	end
end)

clickReward.OnClientEvent:Connect(showPopup)
</ProtectedString>
