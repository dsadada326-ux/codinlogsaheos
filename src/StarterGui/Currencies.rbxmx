			<Item class="LocalScript" referent="RBX2ED6A1F5DB4543798E1C379144E9F40E">
				<Properties>
					<ProtectedString name="Source">local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer

local list = script.Parent
	:WaitForChild("MainCurrenciesFrame")
	:WaitForChild("CurrenciesFrame")

-- UI row name -&gt; saved data name (only where they differ)
local ROW_TO_DATA = {
	Button = "Buttons",
	Money = "Cash",
	Crab = "Crabs",
}

local COUNT_TIME = 0.7 -- seconds a big jump takes to count up (or down)

local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }

local function formatNumber(value)
	value = math.floor(value)

	if value &lt; 1000 then
		return tostring(value)
	end

	local index = 0

	while value &gt;= 1000 and index &lt; #SUFFIXES - 1 do
		value /= 1000
		index += 1
	end

	-- one decimal, rounded down, without a trailing ".0"
	local text = string.format("%.1f", math.floor(value * 10) / 10)
	text = text:gsub("%.0$", "")

	return text .. SUFFIXES[index + 1]
end

local function bindRow(row)
	local valueLabel = row:FindFirstChild("Value")

	if not (valueLabel and valueLabel:IsA("TextLabel")) then
		return
	end

	local dataName = ROW_TO_DATA[row.Name] or row.Name

	local bump = Instance.new("UIScale")
	bump.Name = "Bump"
	bump.Parent = valueLabel

	-- the number on screen. Big changes tween it so it counts instead of snapping.
	local shown = Instance.new("NumberValue")
	shown.Value = player:GetAttribute(dataName) or 0
	valueLabel.Text = formatNumber(shown.Value)

	shown:GetPropertyChangedSignal("Value"):Connect(function()
		local text = formatNumber(shown.Value)

		if valueLabel.Text ~= text then
			valueLabel.Text = text
		end
	end)

	local countTween = nil
	local lastTarget = shown.Value

	local function refresh()
		local target = player:GetAttribute(dataName) or 0
		local change = math.abs(target - shown.Value)

		if countTween then
			countTween:Cancel()
			countTween = nil
		end

		if change &lt; math.max(5, math.abs(target) * 0.02) then
			-- small change (like a click): show it right away
			shown.Value = target
		else
			countTween = TweenService:Create(
				shown,
				TweenInfo.new(
					COUNT_TIME,
					Enum.EasingStyle.Quart,
					Enum.EasingDirection.Out
				),
				{ Value = target }
			)

			countTween:Play()
		end

		-- little pop whenever the shown number goes up or down a step
		if formatNumber(target) ~= formatNumber(lastTarget) then
			bump.Scale = 1.18

			TweenService:Create(
				bump,
				TweenInfo.new(
					0.2,
					Enum.EasingStyle.Back,
					Enum.EasingDirection.Out
				),
				{ Scale = 1 }
			):Play()
		end

		lastTarget = target
	end

	player:GetAttributeChangedSignal(dataName):Connect(refresh)
end

for _, row in ipairs(list:GetChildren()) do
	if row:IsA("Frame") then
		bindRow(row)
	end
end
