			<Item class="LocalScript" referent="RBXA3495B40828F4395831728E731C829E6">
				<Properties>
					<ProtectedString name="Source">-- Keeps this SurfaceGui on the board (Workspace.Islands["FishingFrenzySub-1"].FishingTierBoard.Board).
-- It lives in PlayerGui instead of on the part so players can scroll it and click Tier Up.
local gui = script.Parent

local function find()
	local islands = workspace:FindFirstChild("Islands")
	local island = islands and islands:FindFirstChild("FishingFrenzySub-1")
	local model = island and island:FindFirstChild("FishingPrestigeBoard")
	return model and model:FindFirstChild("Board")
end

while true do
	if not gui.Adornee or not gui.Adornee.Parent then
		gui.Adornee = find()
	end
	task.wait(1)
end
</ProtectedString>
