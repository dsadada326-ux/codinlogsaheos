			<Item class="LocalScript" referent="RBX4D18FF9D73A14CF5A0263897DD453D8F">
				<Properties>
					<ProtectedString name="Source">-- Keeps this SurfaceGui on the Fish Tier sign (Workspace.Islands["FishingFrenzySub-1"].FishingTierBoard.Board).
-- It lives in PlayerGui instead of on the part so players can scroll it and click Tier Up.
local gui = script.Parent

local function find()
	local islands = workspace:FindFirstChild("Islands")
	local island = islands and islands:FindFirstChild("FishingFrenzySub-1")
	local model = island and island:FindFirstChild("FishingTierBoard")
	return model and model:FindFirstChild("Board")
end

while true do
	if not gui.Adornee or not gui.Adornee.Parent then
		gui.Adornee = find()
	end
	task.wait(1)
end
</ProtectedString>
