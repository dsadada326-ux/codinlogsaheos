			<Item class="LocalScript" referent="RBXC2C5B606FC374477A0C5EEEA5275AF60">
				<Properties>
					<ProtectedString name="Source">-- Keeps this SurfaceGui on its Laboratory board (Workspace.Labratory.LabBoards.LabMarkBoard.Board).
-- It lives in PlayerGui instead of on the part so players can scroll it and click the button.
local gui = script.Parent

local function find()
	local lab = workspace:FindFirstChild("Labratory")
	local boards = lab and lab:FindFirstChild("LabBoards")
	local model = boards and boards:FindFirstChild("LabMarkBoard")
	return model and model:FindFirstChild("Board")
end

while true do
	if not gui.Adornee or not gui.Adornee.Parent then
		gui.Adornee = find()
	end
	task.wait(1)
end
</ProtectedString>
